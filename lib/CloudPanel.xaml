<!-- Sign-in panel for one cloud provider. Loaded twice (Backup page, restore dialog), so it only uses
     DynamicResource and gets its styles from whatever window it lands in. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel x:Name="CpConnect">
    <TextBlock x:Name="CpBlurb" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
    <Grid x:Name="CpFields" Margin="0,0,0,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="130"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="CpServerLabel" Grid.Row="0" Text="Server address" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <TextBox x:Name="CpServer" Grid.Row="0" Grid.Column="1" Style="{DynamicResource Field}" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,8"/>
      <TextBlock x:Name="CpRegionLabel" Grid.Row="1" Text="Region" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <TextBox x:Name="CpRegion" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Field}" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,8"/>
      <TextBlock x:Name="CpBucketLabel" Grid.Row="2" Text="Bucket" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <TextBox x:Name="CpBucket" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Field}" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,8"/>
      <TextBlock x:Name="CpUserLabel" Grid.Row="3" Text="User name" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <TextBox x:Name="CpUser" Grid.Row="3" Grid.Column="1" Style="{DynamicResource Field}" Margin="0,0,0,8"/>
      <TextBlock x:Name="CpPassLabel" Grid.Row="4" Text="Password" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <PasswordBox x:Name="CpPass" Grid.Row="4" Grid.Column="1" Style="{DynamicResource PassField}" Margin="0,0,0,8"/>
      <CheckBox x:Name="CpPathStyle" Grid.Row="5" Grid.Column="1" Style="{DynamicResource Chk}" IsChecked="True" Margin="0,2,0,8"
                Content="Path-style addresses (needed for MinIO, Garage and most self-hosted servers)"/>
      <TextBlock x:Name="CpHint" Grid.Row="6" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <Button x:Name="CpConnectBtn" Style="{DynamicResource BtnShiny}">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="CpConnectIcon" Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="0,1,10,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="CpConnectText" Text="Connect"/>
        </StackPanel>
      </Button>
      <Button x:Name="CpCancel" Style="{DynamicResource BtnLink}" Content="Cancel" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <TextBlock x:Name="CpStatus" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
  </StackPanel>
  <Border x:Name="CpAccount" Background="{DynamicResource Panel2}" CornerRadius="10" Padding="14,12" Visibility="Collapsed">
    <DockPanel>
      <Button x:Name="CpDisconnect" DockPanel.Dock="Right" Style="{DynamicResource BtnLink}" Content="Sign out" VerticalAlignment="Center" Margin="12,0,0,0"
              ToolTip="Forgets this account on this PC. Nothing is deleted from the cloud."/>
      <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Brand}" Margin="0,0,12,0" VerticalAlignment="Center">
        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="CpAccountName" FontWeight="SemiBold"/>
        <TextBlock x:Name="CpAccountWhere" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
        <TextBlock x:Name="CpAccountSpace" Foreground="{DynamicResource Muted}" FontSize="12"/>
      </StackPanel>
    </DockPanel>
  </Border>
  <TextBlock x:Name="CpNote" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
</StackPanel>
