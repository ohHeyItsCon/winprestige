<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPrestige" Width="1320" Height="840" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#16181C" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#16181C"/>
    <SolidColorBrush x:Key="Panel" Color="#1D2025"/>
    <SolidColorBrush x:Key="Panel2" Color="#252930"/>
    <SolidColorBrush x:Key="Hover" Color="#2C313A"/>
    <SolidColorBrush x:Key="Line" Color="#30353F"/>
    <SolidColorBrush x:Key="Text" Color="#E6E8EB"/>
    <SolidColorBrush x:Key="Muted" Color="#8B93A1"/>
    <SolidColorBrush x:Key="Accent" Color="#3D8BFD"/>
    <SolidColorBrush x:Key="AccentHover" Color="#5A9DFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1B3355"/>
    <SolidColorBrush x:Key="Good" Color="#3FB950"/>
    <SolidColorBrush x:Key="Warn" Color="#D29922"/>
    <SolidColorBrush x:Key="Bad" Color="#F85149"/>
    <SolidColorBrush x:Key="Purple" Color="#A371F7"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Thin dark scrollbars -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#3A404B" CornerRadius="4" Margin="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="#3A404B" CornerRadius="4" Margin="2"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#2A2F37"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Header tabs -->
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="15,7">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Hover}"/>
          <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource Accent}"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Hover}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{StaticResource Line}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentHover}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BtnLink" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,2">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Checkbox: rounded square with a tick -->
    <Style x:Key="Chk" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="17" Height="17" CornerRadius="4" BorderThickness="1.5"
                      BorderBrush="#5B6372" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M 3.5 8.5 L 7 12 L 13.5 4.5" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="#9AA3B2"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Toggle switch (label left, switch right) -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent" LastChildFill="True">
              <Border x:Name="track" DockPanel.Dock="Right" Width="38" Height="20" CornerRadius="10"
                      Background="#3A404B" VerticalAlignment="Center" Margin="10,0,0,0">
                <Ellipse x:Name="knob" Width="14" Height="14" Fill="#C9CED6" HorizontalAlignment="Left" Margin="3,0"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Row" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="8,0,6,0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Hover}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SideLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,16,0,8"/>
    </Style>

    <Style x:Key="Thin" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Line}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LogList" TargetType="ListBox">
      <Setter Property="Background" Value="#121417"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter Margin="2,1"/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid TextElement.Foreground="{StaticResource Text}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
          <Grid Width="32" Height="32">
            <Border CornerRadius="8" Background="{StaticResource Accent}">
              <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Image x:Name="LogoImage" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Grid>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="WinPrestige" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Back up, reset, restore" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Right" Width="270" Height="34" CornerRadius="17" Background="{StaticResource Panel2}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="13,0,0,0" FontSize="13"/>
            <TextBlock x:Name="SearchHint" Text="Search  (Ctrl+F)" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                     CaretBrush="{StaticResource Text}" VerticalAlignment="Center" Margin="33,0,12,0"/>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton x:Name="TabApps" GroupName="tabs" Style="{StaticResource TabButton}" IsChecked="True" Content="Apps"/>
          <RadioButton x:Name="TabConfigs" GroupName="tabs" Style="{StaticResource TabButton}" Content="App settings"/>
          <RadioButton x:Name="TabExtras" GroupName="tabs" Style="{StaticResource TabButton}" Content="Extras"/>
          <RadioButton x:Name="TabBackup" GroupName="tabs" Style="{StaticResource TabButton}" Content="Backup"/>
          <RadioButton x:Name="TabRestore" GroupName="tabs" Style="{StaticResource TabButton}" Content="Restore"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <!-- APPS -->
      <Grid x:Name="PageApps">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="228"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,14,14,14">
              <Button x:Name="BtnScan" Style="{StaticResource BtnPrimary}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Scan this PC"/></StackPanel>
              </Button>
              <Button x:Name="BtnLinks" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Look up download links"/></StackPanel>
              </Button>
              <TextBlock Text="SELECT" Style="{StaticResource SideLabel}"/>
              <Button x:Name="BtnSelRecommended" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Recommended"/></StackPanel>
              </Button>
              <Button x:Name="BtnSelAll" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE762;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="All shown"/></StackPanel>
              </Button>
              <Button x:Name="BtnSelNone" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE894;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Clear selection"/></StackPanel>
              </Button>
              <TextBlock Text="SHOW" Style="{StaticResource SideLabel}"/>
              <CheckBox x:Name="ShowGames" Style="{StaticResource Switch}" Content="Games"/>
              <CheckBox x:Name="ShowSystem" Style="{StaticResource Switch}" Content="Windows built-ins"/>
              <CheckBox x:Name="ShowSelectedOnly" Style="{StaticResource Switch}" Content="Selected only"/>
              <TextBlock Text="SUMMARY" Style="{StaticResource SideLabel}"/>
              <Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="12,10">
                <StackPanel x:Name="AppSummary"/>
              </Border>
              <TextBlock x:Name="ScanInfo" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="AppScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="AppColumns" Margin="16,8,12,16"/>
        </ScrollViewer>
        <StackPanel x:Name="AppEmpty" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="36" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AppEmptyText" Text="Scanning your apps..." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" Margin="18,16,18,16"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- APP SETTINGS -->
      <Grid x:Name="PageConfigs" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="228"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
              <Button x:Name="BtnDetectConfigs" Style="{StaticResource BtnPrimary}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Detect again"/></StackPanel>
              </Button>
              <Button x:Name="BtnAddFolder" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F4;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Add a folder..."/></StackPanel>
              </Button>
              <Button x:Name="BtnAddFile" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Add a file..."/></StackPanel>
              </Button>
              <TextBlock Text="SELECT" Style="{StaticResource SideLabel}"/>
              <Button x:Name="BtnCfgRecommended" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Recommended"/></StackPanel>
              </Button>
              <Button x:Name="BtnCfgAll" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE762;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="All"/></StackPanel>
              </Button>
              <Button x:Name="BtnCfgNone" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE894;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Clear selection"/></StackPanel>
              </Button>
              <TextBlock Text="SUMMARY" Style="{StaticResource SideLabel}"/>
              <Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="12,10">
                <StackPanel x:Name="ConfigSummary"/>
              </Border>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,0"
                         Text="Each app's settings get their own folder in the backup, with a Restore-Config.cmd that puts them back after you reinstall the app."/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="ConfigScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="ConfigColumns" Margin="16,14,12,16"/>
        </ScrollViewer>
      </Grid>

      <!-- EXTRAS -->
      <ScrollViewer x:Name="PageExtras" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Margin="24,20,24,24">
          <TextBlock Text="Extras" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Things a reset wipes that aren't apps. Turn on what you want in the backup." Foreground="{StaticResource Muted}" Margin="0,4,0,16"/>
          <StackPanel x:Name="ExtrasList"/>
        </StackPanel>
      </ScrollViewer>

      <!-- BACKUP -->
      <Grid x:Name="PageBackup" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="980" Margin="24,20,24,24">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Where to save the backup" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Pick a folder on your NAS (or any drive the reset won't wipe). Running the backup again updates it in place."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                <DockPanel>
                  <Button x:Name="BtnBrowseDest" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0" Padding="14,7">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/><TextBlock Text="Browse"/></StackPanel>
                  </Button>
                  <TextBox x:Name="DestBox" Style="{StaticResource Field}" FontFamily="Cascadia Mono, Consolas"/>
                </DockPanel>
                <WrapPanel x:Name="DestChips" Margin="0,8,0,0"/>
                <TextBlock x:Name="DestInfo" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="What to do" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="OptInstallers" Style="{StaticResource Switch}" IsChecked="True">
                  <StackPanel><TextBlock Text="Download installers"/><TextBlock Text="Latest official installers from winget, plus any download links you added." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                </CheckBox>
                <CheckBox x:Name="OptConfigs" Style="{StaticResource Switch}" IsChecked="True">
                  <StackPanel><TextBlock Text="Back up app settings"/><TextBlock Text="Everything ticked on the App settings tab." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                </CheckBox>
                <CheckBox x:Name="OptExtras" Style="{StaticResource Switch}" IsChecked="True">
                  <StackPanel><TextBlock Text="Back up extras"/><TextBlock Text="Fonts, environment variables and anything else turned on in Extras." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                </CheckBox>
                <CheckBox x:Name="OptPrune" Style="{StaticResource Switch}" IsChecked="True">
                  <StackPanel><TextBlock Text="Remove apps you no longer have"/><TextBlock Text="Deletes installers and settings this tool saved last time for apps that are now uninstalled or unticked." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                </CheckBox>
                <CheckBox x:Name="OptCloseApps" Style="{StaticResource Switch}" IsChecked="True">
                  <StackPanel><TextBlock Text="Offer to close running apps first"/><TextBlock Text="Settings copy cleanly when the app isn't writing to them." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                </CheckBox>
                <CheckBox x:Name="OptRedownload" Style="{StaticResource Switch}">
                  <StackPanel><TextBlock Text="Re-download everything"/><TextBlock Text="Normally installers that are already the latest version are skipped." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Summary" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <WrapPanel x:Name="BackupStats"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="BtnStartBackup" Style="{StaticResource BtnPrimary}" Padding="22,10" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Start backup" FontSize="14"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnOpenDest" Style="{StaticResource Btn}" Margin="0,0,8,0" Padding="14,10">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/><TextBlock Text="Open folder"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnOpenReport" Style="{StaticResource Btn}" Margin="0" Padding="14,10">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/><TextBlock Text="Open report"/></StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
            <ListBox x:Name="BackupLog" Style="{StaticResource LogList}" Height="280"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- RESTORE -->
      <Grid x:Name="PageRestore" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="268"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
              <TextBlock Text="BACKUP FOLDER" Style="{StaticResource SideLabel}" Margin="2,0,0,8"/>
              <TextBox x:Name="RestorePath" Style="{StaticResource Field}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnBrowseRestore" Style="{StaticResource Btn}" Margin="0,0,6,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/><TextBlock Text="Browse"/></StackPanel>
                </Button>
                <Button x:Name="BtnLoadBackup" Style="{StaticResource Btn}" Margin="0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0"/><TextBlock Text="Load"/></StackPanel>
                </Button>
              </StackPanel>
              <TextBlock x:Name="RestoreInfo" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"/>
              <TextBlock Text="OPTIONS" Style="{StaticResource SideLabel}"/>
              <CheckBox x:Name="OptSkipInstalled" Style="{StaticResource Switch}" Content="Skip apps already installed" IsChecked="True"/>
              <CheckBox x:Name="OptPreferLocal" Style="{StaticResource Switch}" Content="Use saved installers" IsChecked="True"/>
              <CheckBox x:Name="OptOnlineFallback" Style="{StaticResource Switch}" Content="Fall back to winget online" IsChecked="True"/>
              <CheckBox x:Name="OptSilent" Style="{StaticResource Switch}" Content="Silent installs" IsChecked="True"/>
              <CheckBox x:Name="OptTestRun" Style="{StaticResource Switch}" Content="Test run (change nothing)"/>
              <Button x:Name="BtnStartRestore" Style="{StaticResource BtnPrimary}" Margin="0,14,0,6" Padding="12,10">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Start restore" FontSize="14"/></StackPanel>
              </Button>
              <Button x:Name="BtnManualLinks" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Open manual links"/></StackPanel>
              </Button>
              <Button x:Name="BtnQueueGames" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Queue ticked games in Steam"/></StackPanel>
              </Button>
              <Button x:Name="BtnOpenRestoreReport" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0"/><TextBlock Text="Open report"/></StackPanel>
              </Button>
              <TextBlock Text="SUMMARY" Style="{StaticResource SideLabel}"/>
              <Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="12,10">
                <StackPanel x:Name="RestoreSummary"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="210"/>
          </Grid.RowDefinitions>
          <ScrollViewer x:Name="RestoreScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="RestoreColumns" Margin="16,8,12,12"/>
          </ScrollViewer>
          <StackPanel x:Name="RestoreEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="36" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
            <TextBlock Text="Pick a WinPrestige backup folder to restore from." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          <ListBox x:Name="RestoreLog" Grid.Row="1" Style="{StaticResource LogList}" Margin="16,0,16,14"/>
        </Grid>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,7">
      <DockPanel LastChildFill="True">
        <Button x:Name="BtnCancel" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="10,0,0,0" Padding="12,3" Visibility="Collapsed" Content="Cancel"/>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Style="{StaticResource Thin}" Width="240" Margin="12,0,0,0" Visibility="Collapsed" Maximum="1"/>
        <TextBlock x:Name="AdminBadge" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
