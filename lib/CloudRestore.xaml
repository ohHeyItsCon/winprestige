<!-- "Load from a cloud account" dialog on the Restore tab. Styles come from the main window. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load a backup from the cloud" Width="720" Height="760" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">
  <Grid TextElement.Foreground="{DynamicResource Text}" Margin="22,18,22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Load a backup from the cloud" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="Sign in to the account you backed up to. WinPrestige lists your backups, downloads the one you pick and checks every file before loading it."
                 Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
      <ComboBox x:Name="RcKind" Style="{DynamicResource Combo}" HorizontalAlignment="Left" MinWidth="400" Height="52" Margin="0,0,0,12"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
      <StackPanel x:Name="RcHost"/>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button x:Name="RcRefresh" DockPanel.Dock="Right" Style="{DynamicResource BtnLink}" Content="Look again" VerticalAlignment="Center" Margin="0"/>
        <TextBlock Text="BACKUPS IN THIS ACCOUNT" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="RcListInfo" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="2,0,0,6"/>
      <ListBox x:Name="RcList" Style="{DynamicResource PickList}" MinHeight="90"/>
    </DockPanel>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="DOWNLOAD TO" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <DockPanel>
        <Button x:Name="RcBrowse" DockPanel.Dock="Right" Style="{DynamicResource Btn}" Margin="8,0,0,0" Padding="14,8" Content="Browse"/>
        <TextBox x:Name="RcDest" Style="{DynamicResource Field}" FontFamily="Cascadia Mono, Consolas"/>
      </DockPanel>
      <TextBlock x:Name="RcStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
      <ProgressBar x:Name="RcProgress" Style="{DynamicResource Thin}" Margin="0,8,0,0" Maximum="100" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="RcClose" Style="{DynamicResource Btn}" Padding="18,9" Margin="0,0,8,0" Content="Close"/>
        <Button x:Name="RcDownload" Style="{DynamicResource BtnPrimary}" Padding="20,9" Margin="0" IsEnabled="False">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/><TextBlock Text="Download and load"/></StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
