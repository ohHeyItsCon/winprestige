[
  {
    "id": "obs", "name": "OBS Studio", "app": "^OBS Studio",
    "processes": ["obs64", "obs32"],
    "items": [
      { "path": "%APPDATA%\\obs-studio", "exclude": ["logs", "crashes", "profiler_data", "updates", ".sentinel", "Cache", "Code Cache", "GPUCache", "DawnCache", "DawnGraphiteCache", "DawnWebGPUCache", "blob_storage", "Crashpad"] },
      { "path": "%PROGRAMDATA%\\obs-studio\\plugins" }
    ],
    "rewrite": ["%APPDATA%\\obs-studio\\basic\\scenes\\*.json", "%APPDATA%\\obs-studio\\basic\\profiles\\*\\basic.ini", "%APPDATA%\\obs-studio\\global.ini", "%APPDATA%\\obs-studio\\user.ini"],
    "special": "obsMedia",
    "notes": "Scene collections, profiles, hotkeys, docks and plugin settings, plus plugins installed in ProgramData. Plugins inside Program Files\\obs-studio must be reinstalled."
  },
  {
    "id": "fancontrol", "name": "FanControl", "app": "^FanControl$",
    "processes": ["FanControl"], "services": ["FanControl.Service"],
    "installDirFallback": ["%PROGRAMFILES(X86)%\\FanControl", "%PROGRAMFILES%\\FanControl"],
    "items": [
      { "path": "%INSTALLDIR%\\Configurations", "exclude": ["*.deps.json", "*.runtimeconfig.json"] },
      { "path": "%INSTALLDIR%\\Plugins" }
    ],
    "notes": "Fan curves, controls and sensor names. Restored into FanControl's install folder after it is reinstalled. Sensors match on the same hardware."
  },
  {
